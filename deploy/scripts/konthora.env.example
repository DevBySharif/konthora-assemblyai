# =============================================================================
# Konthora — deploy script configuration
# =============================================================================
# Copy to deploy/scripts/konthora.env on the VPS and adjust as needed.
# All deploy/scripts/*.sh source this file for paths and settings.
#
#   sudo cp konthora.env.example /opt/konthora/repo/deploy/scripts/konthora.env
#   sudo nano /opt/konthora/repo/deploy/scripts/konthora.env
# =============================================================================

# Git repository and target layout
REPO_URL=https://github.com/DevBySharif/konthora.git
APP_DIR=/opt/konthora
REPO_DIR=/opt/konthora/repo
BACKEND_DIR=/opt/konthora/repo/backend

# Service account and systemd unit name
SERVICE_USER=konthora
SERVICE_GROUP=konthora
SERVICE_NAME=konthora.service
WEB_SERVICE_NAME=konthora-web.service

# Frontend env file loaded by konthora-web.service at runtime and used to set
# NEXT_PUBLIC_* during `next build`.
WEB_ENV_FILE=/etc/konthora/web.env
# Template used to generate the frontend env file on first deploy.
WEB_ENV_TEMPLATE=$REPO_DIR/.env.production.example

# Node.js major version to install for the frontend build (nodesource repo).
NODE_MAJOR=22
FRONTEND_DIR=$REPO_DIR

# Backend secrets file loaded by the systemd unit
BACKEND_ENV_FILE=/etc/konthora/konthora.env
# Template used to generate the secrets file on first deploy
BACKEND_ENV_TEMPLATE=$BACKEND_DIR/.env.production.example

# Storage and log directories (must match backend/.env.production.example)
STORAGE_DIR=/opt/konthora/repo/backend/storage
LOG_DIR=/var/log/konthora

# ML model cache (must match HF_HOME/XDG_CACHE_HOME in the systemd unit).
# Created by deploy.sh / provision_models.sh and owned by the service account.
CACHE_ROOT=/opt/konthora/.cache
HF_CACHE_DIR=/opt/konthora/.cache/huggingface

# Nginx
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
NGINX_API_CONF=api.konthora.dev.bd.conf
NGINX_WEB_CONF=konthora.dev.bd.conf
NGINX_CONF_DIR=/etc/nginx/conf.d

# Let's Encrypt
CERT_DOMAIN=api.konthora.dev.bd
CERT_EMAIL=hello@konthora.dev.bd
# Frontend certificate covers the apex and www (issued together).
WEB_CERT_DOMAINS=konthora.dev.bd www.konthora.dev.bd

# Backups
BACKUP_DIR=/opt/konthora/backups
BACKUP_KEEP_DAYS=7
