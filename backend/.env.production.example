# =============================================================================
# Konthora Backend — PRODUCTION Environment Template
# =============================================================================
# Copy to the VPS as /etc/konthora/konthora.env (referenced by the systemd unit
# konthora.service). Permissions must be 600 and owned by root:
#   sudo install -o root -g root -m 600 konthora.env /etc/konthora/konthora.env
#
# Only variables declared in app/core/config.py are honoured. Everything else
# is ignored.
# =============================================================================

# --- Application runtime -----------------------------------------------------
APP_ENV=production

# systemd runs uvicorn bound to 127.0.0.1:8000. Nginx terminates TLS and proxies
# api.konthora.dev.bd -> 127.0.0.1:8000.
APP_HOST=127.0.0.1
APP_PORT=8000

# --- CORS / Proxy / Host validation -------------------------------------------
# The single browser origin allowed to call the API in production.
CORS_ORIGINS=https://konthora.dev.bd

# MUST be true behind Nginx so client IPs are extracted from X-Forwarded-For
# for rate limiting. uvicorn is started with --proxy-headers and
# --forwarded-allow-ips 127.0.0.1 so only the local proxy is trusted.
TRUST_PROXY_HEADERS=true

# Host header allowlist. Rejects requests whose Host is not the API domain.
TRUSTED_HOSTS=api.konthora.dev.bd

# GZip-compress JSON responses (audio never compressed).
COMPRESSION_ENABLED=true

# Log severity for journald + /var/log/konthora/konthora.log.
LOG_LEVEL=INFO

# Rotating file log directory (50 MB rotation / 7 days retention / zip). The
# deploy script creates this directory with the konthora user as owner.
LOG_DIR=/var/log/konthora

# Expired-job cleanup cadence (seconds).
CLEANUP_INTERVAL_SECONDS=60
# Metadata purge grace after expiry (seconds).
CLEANUP_PURGE_AFTER_EXPIRY_SECONDS=900

# --- Text-to-Speech -----------------------------------------------------------
TTS_MAX_CHARACTERS=2000
TTS_MAX_QUEUE_SIZE=10
TTS_WORKER_COUNT=1
TTS_JOB_RETENTION_MINUTES=60
# Absolute path on the VPS. The deploy script creates it and the systemd unit
# grants read/write to it via ReadWritePaths.
TTS_STORAGE_ROOT=/opt/konthora/repo/backend/storage
TTS_DEFAULT_VOICE=af_heart
TTS_MIN_SPEED=0.75
TTS_MAX_SPEED=1.25
TTS_SENTENCE_PAUSE_MS=220
TTS_PARAGRAPH_PAUSE_MS=500
TTS_ENABLE_MP3=true

TTS_RATE_LIMIT_REQUESTS=10
TTS_RATE_LIMIT_WINDOW_SECONDS=3600

# eSpeak NG auto-discovery on Ubuntu finds /usr/lib/x86_64-linux-gnu/espeak-ng-data
# via PATH (espeak-ng binary in /usr/bin). Leave empty unless a custom install is used.
ESPEAK_PATH=

# --- Transcription -------------------------------------------------------------
TRANSCRIPTION_MODEL=small.en
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8
TRANSCRIPTION_MAX_FILE_SIZE_MB=100
TRANSCRIPTION_MAX_DURATION_SECONDS=600
TRANSCRIPTION_MAX_QUEUE_SIZE=5
TRANSCRIPTION_WORKER_COUNT=1
TRANSCRIPTION_JOB_RETENTION_MINUTES=60
TRANSCRIPTION_BEAM_SIZE=5
TRANSCRIPTION_VAD_ENABLED=true
TRANSCRIPTION_VAD_MIN_SILENCE_MS=500
TRANSCRIPTION_VAD_SPEECH_PAD_MS=400
TRANSCRIPTION_WORD_TIMESTAMPS=true
TRANSCRIPTION_SENTENCE_MAX_CHARACTERS=280
TRANSCRIPTION_PARAGRAPH_MAX_CHARACTERS=900
TRANSCRIPTION_PARAGRAPH_MAX_DURATION_SECONDS=45
TRANSCRIPTION_PARAGRAPH_GAP_SECONDS=1.5
TRANSCRIPTION_SUBTITLE_MAX_CHARACTERS=84
TRANSCRIPTION_SUBTITLE_MAX_LINES=2

TRANSCRIPTION_RATE_LIMIT_REQUESTS=5
TRANSCRIPTION_RATE_LIMIT_WINDOW_SECONDS=3600
TRANSCRIPTION_ACTIVE_JOBS_PER_CLIENT=1
TRANSCRIPTION_FFPROBE_TIMEOUT_SECONDS=15
TRANSCRIPTION_FFMPEG_TIMEOUT_SECONDS=120
