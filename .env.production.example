# =============================================================================
# Konthora Frontend — Production Environment Variable Template
# =============================================================================
# Used by the self-hosted (non-Vercel) deployment. The deploy script copies this
# to /etc/konthora/web.env (mode 600) at build/run time, and both the build
# (next build) and the runtime (konthora-web.service) read it.
#
# NEXT_PUBLIC_* variables are inlined by Next.js at build time AND read at
# runtime, so keep them in sync with the backend CORS_ORIGINS allowlist.
# =============================================================================

# Canonical production URL of the frontend. Used for canonical tags, sitemap.xml,
# robots.txt, OpenGraph and JSON-LD structured data.
NEXT_PUBLIC_SITE_URL=https://konthora.dev.bd

# Public support / copyright contact email.
NEXT_PUBLIC_CONTACT_EMAIL=hello@konthora.dev.bd

# Base URL of the FastAPI backend (must include /api/v1). The provenance of
# this origin MUST appear in the backend CORS_ORIGINS allowlist.
NEXT_PUBLIC_API_URL=https://api.konthora.dev.bd/api/v1

# Google Analytics 4 Measurement ID (format G-XXXXXXXXXX). When set, the official
# Next.js GA integration (@next/third-parties) loads gtag.js in production only.
# Leave blank to disable. Value in GA4 Admin -> Data Streams -> Measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HT9EXF1E52

# Microsoft Clarity project ID. When set, the Clarity script is loaded in
# production only (after the page becomes interactive, non-blocking). Leave
# blank to disable analytics. The real value lives only in /etc/konthora/web.env
# (mode 600); the Clarity dashboard shows it under Settings -> Project ID.
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxqzh8s5z5