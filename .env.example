# =============================================================================
# Konthora Frontend — Environment Variable Template
# =============================================================================
# Development:  copy this file to .env.local and adjust values.
# Production:   set the same variables in the Vercel project settings
#               (Settings -> Environment Variables) — they are build-time
#               variables, so every deployment reads them at build time.
#
# Only NEXT_PUBLIC_* variables are exposed to the browser. Keep the production
# values in sync with your Vercel configuration and backend CORS allowlist.
# =============================================================================

# --- Site identity -------------------------------------------------------------
# Canonical production URL of the frontend. Used for canonical tags, sitemap.xml,
# robots.txt, OpenGraph and JSON-LD structured data.
#   Development: http://localhost:3000
#   Production:  https://konthora.dev.bd
NEXT_PUBLIC_SITE_URL=https://konthora.dev.bd

# Public support / copyright contact email.
NEXT_PUBLIC_CONTACT_EMAIL=hello@konthora.dev.bd

# --- Backend API ---------------------------------------------------------------
# Base URL of the FastAPI backend (must include /api/v1).
#   Development: http://localhost:8000/api/v1
#   Production:  https://api.konthora.dev.bd/api/v1
#
# IMPORTANT: the origin of this URL MUST appear in the backend CORS_ORIGINS
# allowlist, otherwise browsers will block requests.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Google Analytics 4 (production only) --------------------------------------
# GA4 Measurement ID (format G-XXXXXXXXXX). When set, the official Next.js
# GA integration (@next/third-parties) loads gtag.js in production only and
# tracks client-side route changes. Leave blank to disable GA4.
#   Development: (leave empty)
#   Production:  G-HT9EXF1E52 (from GA4 Admin -> Data Streams -> Measurement ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Microsoft Clarity (analytics, production only) ---------------------------
# Microsoft Clarity project ID. When set, the Clarity script is loaded in
# production only (after the page becomes interactive, non-blocking). Leave
# blank to disable analytics. Never commit the real project ID — copy this
# template to .env.local (dev) or /etc/konthora/web.env (production).
#   Development: (leave empty)
#   Production:  e.g. xxqzh8s5z5 (from the Clarity dashboard "Manage" -> Settings)
NEXT_PUBLIC_CLARITY_PROJECT_ID=
